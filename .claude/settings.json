{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(*.env)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(grep *.env*)",
      "Bash(sed *.env*)",
      "Bash(awk *.env*)",
      "Bash(vim *.env*)",
      "Bash(nano *.env*)",
      "Bash(bat *.env*)"
    ],
    "allow": [
      "Bash(rm tmp/*)",
      "Bash(rm -r tmp/*)",
      "Bash(rm -rf tmp/*)"
    ],
    "ask": [
      "Bash(rm *)"
    ]
  }
}
