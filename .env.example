# `make env` で .env にコピーして使う。.env は Git 管理外。
# 以下は開発用のサンプル値。本番では必ず変更すること。

POSTGRES_USER=taskapp
POSTGRES_PASSWORD=taskapp_dev_password
POSTGRES_DB=taskapp

# 認証用 JWT の署名鍵(開発用。本番では十分に長いランダム値にする)
JWT_SECRET=dev-only-change-me

# ホストに公開するポート(ローカルで使用中の場合は変更する)
BACKEND_PORT=8080
FRONTEND_PORT=5173
DB_PORT=5433

# コンテナ内ユーザーの UID/GID(`id -u` / `id -g`)。生成ファイルの所有者を合わせる
HOST_UID=1000
HOST_GID=1000
